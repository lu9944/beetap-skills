# beetap-cli template: cp .env.example .env, then uncomment what you need (all optional)
# Precedence: CLI args > environment > .env > defaults; use --env <path> for another file

#BEETAP_URL=http://127.0.0.1:9318  # plugin endpoint (default; follows -Dbeetap.cliPort)
#BEETAP_MODULE=lark-tap            # default project (required if multiple)
#BEETAP_TIMEOUT=6m                 # HTTP timeout (default 360s; must exceed request timeoutMs)

# Device connection is managed by the IDEA plugin UI (protocol v1 / plugin 1.3.10+):
# CLI has no connection parameters anymore.
